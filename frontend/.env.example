# =============================================================================
# Frontend environment — Blade Rocking & Creep Test System
#
# PRIVATE NETWORK DEPLOYMENT:
#   In production (behind NGINX), leave VITE_API_BASE_URL and VITE_WS_URL
#   EMPTY — the browser hits the same origin and NGINX routes /api/* to the
#   backend automatically. No hardcoded server IP needed in the frontend.
#
# For local development only (running `npm run dev` on your laptop):
#   VITE_API_BASE_URL=http://192.168.1.50:8000
#   VITE_WS_URL=ws://192.168.1.50:8000
# =============================================================================

# Leave blank for Docker/NGINX deployment (same-origin proxying)
VITE_API_BASE_URL=
VITE_WS_URL=

VITE_APP_TITLE=Blade Rocking & Creep Test System
VITE_APP_VERSION=1.0.0

# One frontend build is served to every station (see CLAUDE.md), so this
# can't be a per-station build flag — every browser defaults to
# http://localhost:8090 and it's a runtime health check (see
# frontend/src/services/localOcr.ts), not this setting, that decides
# whether a given station actually uses it. A station running its own OCR
# companion service (scripts/hptr_ocr_service.py / docker-compose.hptr-
# ocr.yml — e.g. the HPTR PC) just needs that service listening on 8090;
# nothing to set here. Only uncomment this if a station's companion service
# needs a different port.
# VITE_LOCAL_OCR_SERVICE_URL=http://localhost:8091
