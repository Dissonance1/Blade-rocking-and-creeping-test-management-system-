# =============================================================================
# Single-machine deployment — Environment Configuration
# Copy to .env and fill in real values.  NEVER commit .env to git.
# Used by docker-compose.yml (demo / dev laptop / single-PC all-in-one).
# For the real plant (OH station) deployment, see .env.oh.example instead.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Internal container hostname used by docker-compose.yml
DATABASE_URL=postgresql+asyncpg://blade_user:changeme_db@postgres:5432/blade_rocking
POSTGRES_DB=blade_rocking
POSTGRES_USER=blade_user
POSTGRES_PASSWORD=changeme_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme_redis@redis:6379/0
REDIS_PASSWORD=changeme_redis
CELERY_BROKER_URL=redis://:changeme_redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme_redis@redis:6379/2

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
OCR_PROVIDER=paddleocr
MAX_FILE_SIZE_MB=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Include this machine's LAN IP if other devices on the network will access it,
# e.g. CORS_ORIGINS=http://localhost,http://192.168.1.50
CORS_ORIGINS=
